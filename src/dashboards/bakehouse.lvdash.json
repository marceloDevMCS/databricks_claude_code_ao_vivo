{
  "datasets": [
    { "name": "kpis", "displayName": "Indicadores", "queryLines": ["SELECT SUM(revenue) AS total_revenue, SUM(orders) AS total_orders, SUM(revenue) / NULLIF(SUM(orders), 0) AS average_ticket, COUNT(*) AS active_franchises FROM franchise_performance "] },
    { "name": "daily_sales", "displayName": "Receita diária", "queryLines": ["SELECT transaction_day, SUM(revenue) AS revenue FROM daily_sales_by_franchise GROUP BY transaction_day "] },
    { "name": "product_sales", "displayName": "Receita por produto", "queryLines": ["SELECT product_name, revenue, units_sold FROM sales_by_product ORDER BY revenue DESC LIMIT 10 "] },
    { "name": "franchise_rank", "displayName": "Ranking de franquias", "queryLines": ["SELECT franchise_name, revenue FROM franchise_performance ORDER BY revenue DESC LIMIT 10 "] },
    { "name": "franchises", "displayName": "Mapa de franquias", "queryLines": ["SELECT franchise_name, latitude, longitude, revenue FROM franchise_performance "] },
    { "name": "payments", "displayName": "Meios de pagamento", "queryLines": ["SELECT payment_method, revenue, orders FROM sales_by_payment_method "] },
    { "name": "sentiment", "displayName": "Sentimento dos reviews", "queryLines": ["SELECT sentiment, SUM(review_count) AS review_count FROM sentiment_by_franchise GROUP BY sentiment ORDER BY review_count DESC "] },
    { "name": "country_sales", "displayName": "Receita por país", "queryLines": ["SELECT country, revenue, orders, active_franchises FROM sales_by_country "] }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Visão geral",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        { "widget": { "name": "total-revenue", "queries": [{ "name": "main_query", "query": { "datasetName": "kpis", "fields": [{ "name": "total_revenue", "expression": "`total_revenue`" }], "disaggregated": true } }], "spec": { "version": 2, "widgetType": "counter", "encodings": { "value": { "fieldName": "total_revenue", "displayName": "Receita total", "format": { "type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": { "type": "max", "places": 2 } } } }, "frame": { "showTitle": true, "title": "Receita total" } } }, "position": { "x": 0, "y": 0, "width": 3, "height": 3 } },
        { "widget": { "name": "total-orders", "queries": [{ "name": "main_query", "query": { "datasetName": "kpis", "fields": [{ "name": "total_orders", "expression": "`total_orders`" }], "disaggregated": true } }], "spec": { "version": 2, "widgetType": "counter", "encodings": { "value": { "fieldName": "total_orders", "displayName": "Pedidos" } }, "frame": { "showTitle": true, "title": "Pedidos" } } }, "position": { "x": 3, "y": 0, "width": 3, "height": 3 } },
        { "widget": { "name": "average-ticket", "queries": [{ "name": "main_query", "query": { "datasetName": "kpis", "fields": [{ "name": "average_ticket", "expression": "`average_ticket`" }], "disaggregated": true } }], "spec": { "version": 2, "widgetType": "counter", "encodings": { "value": { "fieldName": "average_ticket", "displayName": "Ticket médio", "format": { "type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": { "type": "max", "places": 2 } } } }, "frame": { "showTitle": true, "title": "Ticket médio" } } }, "position": { "x": 6, "y": 0, "width": 3, "height": 3 } },
        { "widget": { "name": "active-franchises", "queries": [{ "name": "main_query", "query": { "datasetName": "kpis", "fields": [{ "name": "active_franchises", "expression": "`active_franchises`" }], "disaggregated": true } }], "spec": { "version": 2, "widgetType": "counter", "encodings": { "value": { "fieldName": "active_franchises", "displayName": "Franquias ativas" } }, "frame": { "showTitle": true, "title": "Franquias ativas" } } }, "position": { "x": 9, "y": 0, "width": 3, "height": 3 } },
        { "widget": { "name": "daily-revenue", "queries": [{ "name": "main_query", "query": { "datasetName": "daily_sales", "fields": [{ "name": "transaction_day", "expression": "`transaction_day`" }, { "name": "revenue", "expression": "SUM(`revenue`)" }], "disaggregated": false, "orders": [{ "direction": "ASC", "expression": "`transaction_day`" }] } }], "spec": { "version": 3, "widgetType": "line", "encodings": { "x": { "fieldName": "transaction_day", "scale": { "type": "temporal" } }, "y": { "fieldName": "revenue", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Receita diária" } } }, "position": { "x": 0, "y": 3, "width": 12, "height": 5 } },
        { "widget": { "name": "product-revenue", "queries": [{ "name": "main_query", "query": { "datasetName": "product_sales", "fields": [{ "name": "product_name", "expression": "`product_name`" }, { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }], "disaggregated": false, "orders": [{ "direction": "DESC", "expression": "SUM(`revenue`)" }] } }], "spec": { "version": 3, "widgetType": "bar", "encodings": { "x": { "fieldName": "product_name" }, "y": { "fieldName": "sum(revenue)", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Receita por produto" } } }, "position": { "x": 0, "y": 8, "width": 6, "height": 5 } },
        { "widget": { "name": "franchise-ranking", "queries": [{ "name": "main_query", "query": { "datasetName": "franchise_rank", "fields": [{ "name": "franchise_name", "expression": "`franchise_name`" }, { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }], "disaggregated": false, "orders": [{ "direction": "DESC", "expression": "SUM(`revenue`)" }] } }], "spec": { "version": 3, "widgetType": "bar", "encodings": { "x": { "fieldName": "franchise_name" }, "y": { "fieldName": "sum(revenue)", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Ranking de franquias" } } }, "position": { "x": 6, "y": 8, "width": 6, "height": 5 } },
        { "widget": { "name": "franchise-map", "queries": [{ "name": "main_query", "query": { "datasetName": "franchises", "fields": [{ "name": "latitude", "expression": "`latitude`" }, { "name": "longitude", "expression": "`longitude`" }, { "name": "revenue", "expression": "SUM(`revenue`)" }, { "name": "franchise_name", "expression": "`franchise_name`" }], "disaggregated": false } }], "spec": { "version": 2, "widgetType": "symbol-map", "encodings": { "coordinates": { "latitude": { "fieldName": "latitude" }, "longitude": { "fieldName": "longitude" } }, "size": { "fieldName": "revenue", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Receita por localização" } } }, "position": { "x": 0, "y": 13, "width": 6, "height": 5 } },
        { "widget": { "name": "payment-mix", "queries": [{ "name": "main_query", "query": { "datasetName": "payments", "fields": [{ "name": "payment_method", "expression": "`payment_method`" }, { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }], "disaggregated": false } }], "spec": { "version": 3, "widgetType": "pie", "encodings": { "angle": { "fieldName": "sum(revenue)", "scale": { "type": "quantitative" } }, "color": { "fieldName": "payment_method", "scale": { "type": "categorical" } }, "label": { "show": true } }, "frame": { "showTitle": true, "title": "Mix de meio de pagamento" } } }, "position": { "x": 6, "y": 13, "width": 6, "height": 5 } },
        { "widget": { "name": "review-sentiment", "queries": [{ "name": "main_query", "query": { "datasetName": "sentiment", "fields": [{ "name": "sentiment", "expression": "`sentiment`" }, { "name": "sum(review_count)", "expression": "SUM(`review_count`)" }], "disaggregated": false } }], "spec": { "version": 3, "widgetType": "bar", "encodings": { "x": { "fieldName": "sentiment" }, "y": { "fieldName": "sum(review_count)", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Reviews por sentimento" } } }, "position": { "x": 0, "y": 18, "width": 6, "height": 5 } },
        { "widget": { "name": "country-revenue", "queries": [{ "name": "main_query", "query": { "datasetName": "country_sales", "fields": [{ "name": "country", "expression": "`country`" }, { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }], "disaggregated": false, "orders": [{ "direction": "DESC", "expression": "SUM(`revenue`)" }] } }], "spec": { "version": 3, "widgetType": "bar", "encodings": { "x": { "fieldName": "country" }, "y": { "fieldName": "sum(revenue)", "scale": { "type": "quantitative" } } }, "frame": { "showTitle": true, "title": "Receita por país" } } }, "position": { "x": 6, "y": 18, "width": 6, "height": 5 } }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": { "light": "#FCFCFC", "dark": "#1F272D" },
      "widgetBackgroundColor": { "light": "#FFFFFF", "dark": "#11171C" },
      "fontColor": { "light": "#11171C", "dark": "#E8ECF0" },
      "selectionColor": { "light": "#2272B4", "dark": "#8ACAFF" },
      "visualizationColors": ["#FFA600", "#FF7054", "#DE5582", "#995495", "#4E5185", "#1D425C", "#99DDB4"],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}

